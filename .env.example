# Optional. Leave unset to call the API on the same origin, which is how the
# app is deployed: Caddy serves the built PWA and proxies /api to Django.
# Only set this when the PWA and API really are on different origins. Never set
# it to localhost: `npm run dev` already proxies /api and /media, and a
# production build pointing at localhost would make every device call itself.
# VITE_API_URL=https://api.example.com
