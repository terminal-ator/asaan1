[Unit]
Description=Asaan API and console (Django)
After=network.target

[Service]
User=asaan
Group=asaan
WorkingDirectory=/opt/asaan/django_api
EnvironmentFile=/etc/asaan/asaan.env
ExecStart=/opt/asaan/django_api/.venv/bin/gunicorn asaan.wsgi:application \
    --bind 127.0.0.1:${GUNICORN_PORT} \
    --workers 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    --max-requests 1000 \
    --max-requests-jitter 100
# `systemctl reload asaan` drains workers and starts fresh ones, so a deploy
# does not drop in-flight requests.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/asaan

[Install]
WantedBy=multi-user.target
