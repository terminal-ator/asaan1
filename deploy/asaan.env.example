# Copy to /etc/asaan/asaan.env and fill in. Keep the file readable only by the
# service account: chown root:asaan /etc/asaan/asaan.env && chmod 640 ...
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=asaan.in,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://asaan.in
DJANGO_SECURE_COOKIES=true

# Internal gunicorn port. Keep in sync with reverse_proxy in the Caddyfile
# (or proxy_pass when using deploy/nginx.conf on a shared server).
GUNICORN_PORT=8123

# Photo uploads.
MEDIA_ROOT=/var/lib/asaan/media

# --- Database: pick one -----------------------------------------------------
# SQLite (default): a single file, nothing else to run.
DATABASE_PATH=/var/lib/asaan/asaan.db

# PostgreSQL, if the server already runs one. Uncomment these five lines and
# remove DATABASE_PATH above; `manage.py migrate` creates the tables. The
# database and role must exist first (see deploy/README.md).
# POSTGRES_DB=asaan
# POSTGRES_USER=asaan
# POSTGRES_PASSWORD=replace-with-the-role-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Only needed if the PWA is hosted on a different origin than the API.
# CORS_ALLOWED_ORIGINS=https://asaan.in
