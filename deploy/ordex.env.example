# Copy to /etc/ordex/ordex.env and fill in. Keep the file readable only by the
# service account: chown root:ordex /etc/ordex/ordex.env && chmod 640 ...
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=orders.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://orders.example.com
DJANGO_SECURE_COOKIES=true
DATABASE_PATH=/var/lib/ordex/ordex.db
MEDIA_ROOT=/var/lib/ordex/media
# Internal gunicorn port. Keep in sync with proxy_pass in nginx.conf.
GUNICORN_PORT=8123
# Only needed if the PWA is hosted on a different origin than the API.
# CORS_ALLOWED_ORIGINS=https://orders.example.com
